# Qloo hackathon key (server-side only). Base URL: https://hackathon.api.qloo.com
QLOO_API_KEY=

# Gemini (server-side only). EITHER set GEMINI_API_KEY (Google AI Studio key), OR use Vertex AI below.
GEMINI_API_KEY=

# Vertex AI option
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
# Local dev: `gcloud auth application-default login` (no key needed).
# Vercel: base64 of a service-account JSON with the "Vertex AI User" role.
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# Accounts (Supabase). Public values; safe to expose to the browser. Leave blank to run in guest mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to 1 only after enabling the Google provider in Supabase.
NEXT_PUBLIC_AUTH_GOOGLE=
